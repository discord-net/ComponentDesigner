<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);ComponentDesignerInterceptors</InterceptorsNamespaces>
        <EnableAutoRows>false</EnableAutoRows>
        <LangVersion>latest</LangVersion>
        <EnableAutoTextDisplay>false</EnableAutoTextDisplay>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="EnableAutoRows" />
        <CompilerVisibleProperty Include="EnableAutoTextDisplay" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\src\ComponentDesigner.Core\ComponentDesigner.Core.csproj" OutputItemType="Analyzer" />
      <ProjectReference Include="..\src\ComponentDesigner.Graph\ComponentDesigner.Graph.csproj" OutputItemType="Analyzer" />
      <ProjectReference Include="..\src\ComponentDesigner.Parser\ComponentDesigner.Parser.csproj" OutputItemType="Analyzer" />
      <ProjectReference Include="..\src\ComponentDesigner.CSharp\ComponentDesigner.CSharp.csproj" OutputItemType="Analyzer" />
      <ProjectReference Include="..\src\Discord.Net.ComponentDesigner.Implementation\Discord.Net.ComponentDesigner.Implementation.csproj" OutputItemType="Analyzer" />
      <ProjectReference Include="..\src\Discord.Net.ComponentDesigner.Generator\Discord.Net.ComponentDesigner.Generator.csproj" OutputItemType="Analyzer" />
      <ProjectReference Include="..\src\Discord.Net.ComponentDesigner\Discord.Net.ComponentDesigner.csproj" />
    </ItemGroup>


</Project>
