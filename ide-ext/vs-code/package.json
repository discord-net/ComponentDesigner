{
  "name": "discord-cx",
  "displayName": "Discord.Net CX",
  "description": "Supports highlighting and suggestions for the CX component language",
  "author": "quinchs",
  "version": "0.0.1",
  "publisher": "quinchs",
  "license": "MIT",
  "repository": "https://github.com/discord-net/Discord.Net",
  "engines": {
    "vscode": "^1.34.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cx.openPreview",
        "title": "Show JSON Preview"
      }
    ],
    "languages": [
      {
        "id": "cx",
        "aliases": [
          "Discord Components"
        ],
        "extensions": [
          ".cx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cx",
        "scopeName": "source.cx",
        "path": "./syntaxes/cx.tmLanguage.json"
      }
    ]
  },
  "scripts": {
      "vscode:prepublish": "pnpm run compile",
      "compile": "tsc -p ./ --skipLibCheck"
    },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.104.0"
  },
  "dependencies": {
    "vscode-languageclient": "^7.0.0"
  },
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ]
}
